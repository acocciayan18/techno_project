rules_version = '2';
// All database access goes through the Express backend using the Firebase Admin SDK,
// which bypasses these rules. No client (browser/mobile) talks to Firestore directly,
// so we deny all direct client access as defense-in-depth.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
