# Base origin of the Express API.
# Leave UNSET for local dev: requests stay relative and the Vite proxy
# (vite.config.js) forwards /api and /uploads to http://localhost:4000.
# Set to the deployed backend origin for a hosted build, e.g.:
#   VITE_API_BASE_URL=https://techno-project-rp8r.onrender.com
VITE_API_BASE_URL=
