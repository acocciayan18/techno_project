# Backend origin used by the production build (Vercel). Points at the Render
# Express server so API calls and image URLs are absolute and cross-origin,
# instead of hitting the Vercel domain (which has no backend -> 404).
# VITE_ vars are baked into the client bundle at build time; this value is public.
VITE_API_BASE_URL=https://techno-project-rp8r.onrender.com
