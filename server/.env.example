# ---- Server ----
PORT=4000
# Public base URL that physical QR codes point to (used when generating QR images).
# In production set this to your deployed domain, e.g. https://lostfound.example.com
PUBLIC_BASE_URL=http://localhost:5173

# Base URL of the user-facing web app, used to build links sent by email (the
# password-reset link). Defaults to PUBLIC_BASE_URL when unset. MUST be your real
# deployed domain in production — a localhost value makes reset links unreachable,
# and the server logs a loud warning if it detects one with NODE_ENV=production.
# APP_URL=https://lostfound.example.com

# Comma separated list of allowed CORS origins (the React dev server, your prod domain).
CORS_ORIGINS=http://localhost:5173

# Number of reverse-proxy hops in front of the app (Express `trust proxy`). REQUIRED
# in production when deployed behind a proxy/load balancer (Render, Fly, Nginx, …):
# without it, req.ip is the proxy's address and every per-IP rate limit (login,
# register, forgot/reset, finder "found" reports) collapses into one shared bucket.
# Set it to the hop count (Render/Fly = 1). Leave UNSET when the app is directly
# internet-facing — setting it then would let clients spoof X-Forwarded-For.
# TRUST_PROXY=1

# ---- Auth ----
# Change this to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Pepper mixed into the HMAC of QR activation codes (proof-of-possession secrets).
# Set a dedicated long random string in production. If unset it falls back to
# JWT_SECRET, then to a dev-only default. Changing it invalidates all codes that
# have NOT yet been used to activate (already-activated QRs are unaffected).
ACTIVATION_SECRET_PEPPER=change-me-to-another-long-random-secret

# ---- Signup CAPTCHA / bot challenge (optional) ----
# Turns on server-side CAPTCHA verification on POST /api/auth/register. LEAVE UNSET
# to disable (dev, tests and API clients then need no token). When set, the register
# route requires a valid token and you must also wire the matching client widget
# (site key) into the Register form. The honeypot + submit-timing + duplicate-email
# + strike-cooldown defences run regardless of this setting.
#   CAPTCHA_PROVIDER: turnstile (default) | hcaptcha — picks the siteverify endpoint.
# CAPTCHA_SECRET=your-captcha-secret-key
# CAPTCHA_PROVIDER=turnstile

# ---- Database mode ----
# Choose ONE of the following three modes.
#
# 1) MEMORY (default if nothing else is set): in-process store. Great for local dev / demos /
#    running the automated tests with zero setup. Data is lost when the server restarts.
# DB_MODE=memory
#
# 2) EMULATOR: run the Firestore emulator (`firebase emulators:start --only firestore`) and set:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_PROJECT_ID=demo-lostfound
#
# 3) CLOUD: a real Firebase project. Provide a service account key.
#    Either point GOOGLE_APPLICATION_CREDENTIALS at the JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
#    ...or inline the JSON (single line) here:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# FIREBASE_PROJECT_ID=your-project-id

# ---- Image storage (item photos) ----
# Where uploaded item photos are stored.
#   local (default in dev / memory / emulator): saved to server/uploads on disk.
#          Simple, but files are LOST on a container redeploy and are not shared
#          across multiple server instances.
#   gcs:   Firebase Cloud Storage — persistent, survives redeploys, reachable from
#          every instance. Auto-selected when DB_MODE=cloud and a bucket resolves.
# Force a mode explicitly (optional): cloudinary | gcs | local
# STORAGE_MODE=cloudinary
#
# -- Option A: Cloudinary (recommended if Firebase Storage can't be enabled) --
# Provide EITHER the single URL (from the Cloudinary dashboard, "API environment
# variable") which already contains the key + secret:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...OR the three discrete values:
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# The API secret is used server-side only — never commit a real value or expose it to the client.
#
# -- Option B: Firebase Cloud Storage (gcs) --
# Bucket to use. Defaults to "<project-id>.appspot.com" when unset; set this if
# your project's default bucket differs (e.g. "<project-id>.firebasestorage.app").
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com
#
# TEST ONLY — never set in production. Disables the SSRF private-IP block so the
# e2e suite can import an image from a loopback test server. Leaving this on would
# let the "import from URL" feature reach internal/metadata endpoints.
# IMAGE_IMPORT_ALLOW_PRIVATE=true

# ---- Email (Brevo transactional API) ----
# Used to send password-reset emails. If BREVO_API_KEY or MAIL_FROM_EMAIL is
# unset, the reset link is logged to the server console instead (dev fallback).
# BREVO_API_KEY=xkeysib-...
# SMTP_FROM=you@yourdomain.com         # must be a VERIFIED sender in Brevo
# MAIL_FROM_NAME=TagBack
# MAIL_REPLY_TO=support@yourdomain.com # optional Reply-To (e.g. a support inbox)

# ---- Seed admin (used by `npm run seed:admin`) ----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=System Admin
